<?xml version="1.0" encoding="UTF-8"?>
<quiqqer>
    <project>

        <settings>
            <config>
                <section name="matomo.settings">
                    <conf name="url">
                        <type><![CDATA[string]]></type>
                    </conf>
                    <conf name="id">
                        <type><![CDATA[string]]></type>
                    </conf>
                    <conf name="token">
                        <type><![CDATA[string]]></type>
                    </conf>
                    <conf name="useTokenForStatisticsDisplay">
                        <type><![CDATA[bool]]></type>
                        <defaultvalue>0</defaultvalue>
                    </conf>
                    <conf name="langdata">
                        <type><![CDATA[string]]></type>
                    </conf>
                    <conf name="cookiecategory">
                        <type><![CDATA[string]]></type>
                        <defaultvalue><![CDATA[statistics]]></defaultvalue>
                    </conf>
                </section>
                <section name="matomo.settings.tagmanager">
                    <conf name="enabled">
                        <type><![CDATA[boolean]]></type>
                    </conf>
                    <conf name="code.general">
                        <type><![CDATA[string]]></type>
                    </conf>
                    <conf name="code.languages">
                        <type><![CDATA[string]]></type>
                    </conf>
                </section>
            </config>

            <window>
                <categories>
                    <category name="matomo">
                        <text>
                            <locale group="quiqqer/matomo"
                                    var="matomo.settings.title"
                            />
                        </text>
                        <icon>fa fa-line-chart</icon>

                        <settings>

                            <title>
                                <locale group="quiqqer/matomo"
                                        var="matomo.settings.general.title"
                                />
                            </title>

                            <input conf="matomo.settings.url" type="url">
                                <text>
                                    <locale group="quiqqer/matomo"
                                            var="matomo.settings.url"
                                    />
                                </text>
                                <description>
                                    <locale group="quiqqer/matomo"
                                            var="matomo.settings.url.description"
                                    />
                                </description>
                            </input>
                            <input conf="matomo.settings.id">
                                <text>
                                    <locale group="quiqqer/matomo"
                                            var="matomo.settings.id"
                                    />
                                </text>
                                <description>
                                    <locale group="quiqqer/matomo"
                                            var="matomo.settings.id.description"
                                    />
                                </description>
                            </input>

                            <input type="hidden" data-qui="package/quiqqer/matomo/bin/controls/SiteIds">
                                <text>
                                    <locale group="quiqqer/matomo"
                                            var="matomo.settings.siteIds"
                                    />
                                </text>
                                <description>
                                    <locale group="quiqqer/matomo"
                                            var="matomo.settings.siteIds.description"
                                    />
                                </description>
                            </input>

                            <input conf="matomo.settings.token">
                                <text>
                                    <locale group="quiqqer/matomo"
                                            var="matomo.settings.token"
                                    />
                                </text>
                                <description>
                                    <locale group="quiqqer/matomo"
                                            var="matomo.settings.token.description"
                                    />
                                </description>
                            </input>

                            <input conf="matomo.settings.useTokenForStatisticsDisplay" type="checkbox">
                                <text>
                                    <locale group="quiqqer/matomo" var="matomo.settings.useTokenForStatisticsDisplay"/>
                                </text>
                                <description>
                                    <locale group="quiqqer/matomo"
                                            var="matomo.settings.useTokenForStatisticsDisplay.description"/>
                                </description>
                            </input>
                        </settings>

                        <settings>
                            <title>
                                <locale group="quiqqer/matomo" var="matomo.settings.cookies.title"/>
                            </title>

                            <select conf="matomo.settings.cookiecategory">
                                <text>
                                    <locale group="quiqqer/matomo" var="matomo.settings.cookiecategory"/>
                                </text>
                                <description>
                                    <locale group="quiqqer/matomo" var="matomo.settings.cookiecategory.description"/>
                                </description>
                                <option value="essential">
                                    <locale group="quiqqer/matomo" var="matomo.settings.cookiecategory.essential"/>
                                </option>
                                <option value="preferences">
                                    <locale group="quiqqer/matomo" var="matomo.settings.cookiecategory.preferences"/>
                                </option>
                                <option value="statistics">
                                    <locale group="quiqqer/matomo" var="matomo.settings.cookiecategory.statistics"/>
                                </option>
                                <option value="marketing">
                                    <locale group="quiqqer/matomo" var="matomo.settings.cookiecategory.marketing"/>
                                </option>
                            </select>
                        </settings>

                        <settings>
                            <title>
                                <locale group="quiqqer/matomo" var="matomo.settings.tagmanager.title"/>
                            </title>

                            <textarea type="hidden"
                                      data-qui="package/quiqqer/html-snippets/bin/backend/controls/SnippetInput"
                                      data-qui-options-snippet="matomo-tm"
                                      data-qui-options-event="onQuiqqer::template::header::begin"
                            >
                                <text>
                                    <locale group="quiqqer/matomo" var="matomo.settings.tagmanager.code.general"/>
                                </text>
                                <description>
                                    <locale group="quiqqer/matomo"
                                            var="matomo.settings.tagmanager.code.general.description"/>
                                </description>
                            </textarea>
                        </settings>
                    </category>
                </categories>
            </window>

        </settings>

    </project>
</quiqqer>
